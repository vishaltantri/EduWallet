# Alchemy RPC (free tier) - https://www.alchemy.com
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Deployer wallet private key (for contract deployment only)
# Generate a new wallet in MetaMask, export private key
# Get free test MATIC from https://faucet.polygon.technology
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# Polygonscan API key (optional, for contract verification)
# Get from https://amoy.polygonscan.com/myapikey
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here
