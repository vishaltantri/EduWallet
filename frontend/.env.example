# ─── Blockchain (optional) ───
# Anchoring is optional: certificates are hashed and signed by the issuing
# institution's wallet regardless, so verification works without a chain.
# Set these after deploying with `npm run contracts:deploy`.
NEXT_PUBLIC_SOULBOUND_ADDRESS=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_RECOVERY_ADDRESS=
NEXT_PUBLIC_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
NEXT_PUBLIC_EXPLORER_URL=https://amoy.polygonscan.com
# Milliseconds before an on-chain write is abandoned (default 12000).
CHAIN_TIMEOUT_MS=12000

# ─── Auth & key custody ───
JWT_SECRET=change-this-to-a-secure-random-string
# Encrypts the server-held copy of each wallet key used to sign certificates.
# Defaults to a value derived from JWT_SECRET; set it explicitly in production.
# Rotating it makes existing institutions unable to sign new certificates until
# they sign in again, so treat it as long-lived.
WALLET_MASTER_KEY=another-long-random-string

# ─── Durable storage (strongly recommended on Vercel) ───
# Without these, accounts and certificates live in one serverless instance's
# memory and vanish on the next cold start. Any Upstash Redis or Vercel KV
# database works — the integration sets these variables for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative to a shared database: a mounted persistent disk. Point this at
# the mount path (a Render disk, a Docker volume) and the file store becomes
# durable. Without either, a container filesystem is wiped on every redeploy
# and the app reports its storage as ephemeral.
DATA_DIR=

# ─── IPFS (Pinata) ───
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
# Override the pinning API base. Only needed for a self-hosted service that
# speaks the same API, or for tests. Defaults to Pinata.
PINATA_API_URL=

# ─── Public URLs ───
# Used in W3C credential documents and share links. Falls back to the request
# origin when unset.
NEXT_PUBLIC_APP_URL=

# ─── Platform relayer (required for on-chain anchoring) ───
# The deploying wallet's key, held server-side only. Institutions get a
# generated wallet when they register, and the certificate contract is
# onlyIssuer — without this key nothing can authorize them, so every mint
# reverts and certificates stay signed but unanchored. The relayer authorizes
# each institution on its first issuance, registers it on the credential
# registry, tops up its gas, and pays for recovery execution.
PLATFORM_PRIVATE_KEY=
# Gas floor and top-up amount for institution wallets, in native currency.
ISSUER_GAS_FLOOR=0.05
ISSUER_GAS_TOPUP=0.1
